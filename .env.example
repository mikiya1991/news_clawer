# ===== 新闻雷达配置 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略）

# DeepSeek API Key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 微信推送渠道（二选一）：
#   serverchan  -> Server酱 (https://sct.ftqq.com)，PUSH_TOKEN 填 SendKey
#   pushplus    -> PushPlus (https://www.pushplus.plus)，PUSH_TOKEN 填 token
# 留空 = 不推送，仅入库
PUSH_PROVIDER=serverchan
PUSH_TOKEN=xxxxxxxxxxxxxxxx

# RSS 订阅源（英文逗号分隔），示例：
RSS_FEEDS=https://www.36kr.com/feed,https://feeds.bbci.co.uk/zhongwen/simp/rss.xml

# X 采集 AI 过滤：入库前用 AI 判断推文是否值得收集（1=开启，0=关闭，默认开启）
# 关闭或 AI 失败时全部入库（fail-open）
# AI_FILTER_ENABLED=1

# 英文推文 AI 中文总结（一句话注释，显示在推文卡片上；1=开启，默认开启）
# AI_SUMMARY_ENABLED=1
